#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper startup script, sourced from the Apache Maven Wrapper project
# (https://maven.apache.org/wrapper/) licensed under ASL 2.0.
# ----------------------------------------------------------------------------

if [ -z "$JAVA_HOME" ]; then
  JAVACMD=$(which java)
else
  JAVACMD="$JAVA_HOME/bin/java"
fi

if [ ! -x "$JAVACMD" ]; then
  echo "Error: JAVA_HOME is not set correctly or java is not on the PATH." >&2
  exit 1
fi

BASE_DIR=$(cd "$(dirname "$0")" && pwd)
WRAPPER_JAR="$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

exec "$JAVACMD" $MAVEN_OPTS $MAVEN_DEBUG_OPTS -classpath "$WRAPPER_JAR" "-Dmaven.multiModuleProjectDirectory=$BASE_DIR" $WRAPPER_LAUNCHER "$@"
